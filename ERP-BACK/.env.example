# Copy this file to ".env" in the same folder as manage.py and fill it in. Keep .env private.

# ---- Database (MySQL) ----
DB_NAME=erp_database
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---- Email (credentials, OTP codes) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@yourdomain.com
EMAIL_HOST_PASSWORD=your-mailbox-password
DEFAULT_FROM_EMAIL=you@yourdomain.com

# ---- Server only (leave out on your own computer) ----
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=a-long-random-string
# DJANGO_ALLOWED_HOSTS=62.72.12.218
# CORS_EXTRA_ORIGINS=http://62.72.12.218:9064,http://62.72.12.218:9065
# COMPANY_LOGIN_URL=http://62.72.12.218:9064/login
# ADMIN_LOGIN_URL=http://62.72.12.218:9065/login
